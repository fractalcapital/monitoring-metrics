[Unit]
Description=Monitoring dashboard API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/monitoring-metrics
EnvironmentFile=/opt/monitoring-metrics/.env
ExecStart=/usr/bin/python3 /opt/monitoring-metrics/api/api_server.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
